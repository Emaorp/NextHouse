@using NextHouse.Web.DTOs.Account
@model LoginDTO

@{
    ViewData["Title"] = "Iniciar Sesión";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
      rel="stylesheet">

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>

    body {
        background-color: #eef5fb;
        font-family: 'Poppins', sans-serif;
    }

    .login-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 80px 15px;
    }

    .login-container {
        width: 100%;
        max-width: 1000px;
        background: white;
        border-radius: 30px;
        overflow: hidden;
        display: flex;
        box-shadow: 0 20px 50px rgba(0,0,0,.08);
    }

    .login-left {
        width: 45%;
        background: linear-gradient(135deg, #0d5c86 0%, #094564 100%);
        padding: 60px 50px;
        color: white;
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .auth-brand-logo {
        width: 85px;
        height: 85px;
        border-radius: 24px;
        background-color: rgba(255,255,255,.15);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 38px;
        margin-bottom: 30px;
    }

    .welcome-title {
        font-size: 42px;
        font-weight: 700;
        line-height: 1.2;
        margin-bottom: 20px;
    }

    .welcome-text {
        color: rgba(255,255,255,.85);
        font-size: 16px;
        line-height: 1.7;
    }

    .register-section {
        margin-top: 40px;
    }

        .register-section p {
            color: rgba(255,255,255,.8);
            margin-bottom: 18px;
        }

    .register-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        height: 52px;
        padding: 0 28px;
        border-radius: 14px;
        background-color: white;
        color: #0d5c86;
        font-weight: 600;
        transition: .3s ease;
    }

        .register-btn:hover {
            background-color: #f1f5f9;
            color: #094564;
        }

    .login-right {
        width: 55%;
        padding: 60px;
        background-color: white;
    }

    .login-title {
        font-size: 36px;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 10px;
    }

    .login-subtitle {
        color: #64748b;
        margin-bottom: 35px;
    }

    .form-label {
        color: #334155;
        font-weight: 500;
        margin-bottom: 10px;
    }

    .input-group-custom {
        position: relative;
        margin-bottom: 22px;
    }

    .input-icon {
        position: absolute;
        top: 18px;
        left: 18px;
        color: #64748b;
        font-size: 17px;
        z-index: 5;
    }

    .form-control {
        height: 58px;
        border-radius: 16px;
        border: 1px solid #dbe2ea;
        padding-left: 50px;
        font-size: 15px;
    }

        .form-control:focus {
            border-color: #0d5c86;
            box-shadow: 0 0 0 .15rem rgba(13,92,134,.15);
        }

    .remember-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }

    .remember-check {
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .remember-check label {
            color: #475569;
            font-size: 14px;
        }

    .forgot-link {
        color: #0d5c86;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
    }

        .forgot-link:hover {
            color: #094564;
        }

    .auth-login-btn {
        width: 100%;
        height: 58px;
        border: none;
        border-radius: 16px;
        background-color: #0d5c86;
        color: white;
        font-size: 16px;
        font-weight: 600;
        transition: .3s ease;
    }

        .login-btn:hover {
            background-color: #094564;
        }

    .divider {
        display: flex;
        align-items: center;
        gap: 15px;
        margin: 35px 0;
        color: #94a3b8;
        font-size: 14px;
    }

        .divider::before,
        .divider::after {
            content: "";
            flex: 1;
            height: 1px;
            background-color: #e2e8f0;
        }

    .social-buttons {
        display: flex;
        gap: 15px;
    }

    .social-btn {
        flex: 1;
        height: 52px;
        border: 1px solid #dbe2ea;
        border-radius: 14px;
        background-color: white;
        color: #334155;
        font-weight: 500;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        transition: .3s ease;
    }

        .social-btn:hover {
            border-color: #0d5c86;
            color: #0d5c86;
        }

    .text-danger {
        font-size: 14px;
        margin-top: 8px;
        display: block;
    }

    @@media(max-width: 992px) {

        .login-container {
            flex-direction: column;
        }

        .login-left,
        .login-right {
            width: 100%;
        }

        .login-left {
            padding: 45px 35px;
        }

        .login-right {
            padding: 45px 35px;
        }

        .welcome-title {
            font-size: 34px;
        }
    }

    @@media(max-width: 576px) {

        .social-buttons {
            flex-direction: column;
        }

        .remember-row {
            flex-direction: column;
            align-items: start;
            gap: 15px;
        }

        .login-title {
            font-size: 30px;
        }
    }

</style>

<div class="login-wrapper">

    <div class="login-container">

        <div class="login-left">

            <div>

                <div class="auth-brand-logo">
                    <i class="bi bi-house-door-fill"></i>
                </div>

                <h1 class="welcome-title">
                    Bienvenido a NextHouse
                </h1>

                <p class="welcome-text">
                    Encuentra propiedades increíbles para comprar o arrendar
                    en las mejores ubicaciones.
                </p>

            </div>

            <div class="register-section">

                <p>
                    ¿Aún no tienes una cuenta?
                </p>

                <a asp-controller="Users"
                       asp-action="Create"
                       class="register-btn">

                    Crear cuenta

                </a>

            </div>

        </div>

        <div class="login-right">

            <h2 class="login-title">
                Iniciar sesión
            </h2>

            <p class="login-subtitle">
                Ingresa tus credenciales para continuar
            </p>

            <form method="post"
                  asp-controller="Account"
                  asp-action="Login">

                <input type="hidden"
                       asp-for="ReturnUrl" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">

                    <label asp-for="Email"
                           class="form-label">
                        Correo electrónico
                    </label>

                    <div class="input-group-custom">

                        <i class="bi bi-envelope-fill input-icon"></i>

                        <input asp-for="Email"
                               class="form-control"
                               placeholder="nombre@correo.com" />

                    </div>

                    <span asp-validation-for="Email"
                          class="text-danger">
                    </span>

                </div>

                <div class="mb-3">

                    <label asp-for="Password"
                           class="form-label">
                        Contraseña
                    </label>

                    <div class="input-group-custom">

                        <i class="bi bi-lock-fill input-icon"></i>

                        <input asp-for="Password"
                               type="password"
                               class="form-control"
                               placeholder="Ingresa tu contraseña" />

                    </div>

                    <span asp-validation-for="Password"
                          class="text-danger">
                    </span>

                </div>

                <div class="remember-row">

                    <div class="remember-check">

                        <input asp-for="RememberMe"
                               class="form-check-input" />

                        <label asp-for="RememberMe">
                            Recordarme
                        </label>

                    </div>

                    <a href="#"
                           class="forgot-link">

                        ¿Olvidaste tu contraseña?

                    </a>

                </div>

                <button type="submit"
                        class="auth-login-btn">

                    Ingresar ahora

                </button>

                <div class="divider">
                    o continúa con
                </div>

                <div class="social-buttons">

                    <button type="button"
                            class="social-btn">

                        <i class="bi bi-google"></i>
                        Google

                    </button>

                    <button type="button"
                            class="social-btn">

                        <i class="bi bi-facebook"></i>
                        Facebook

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
