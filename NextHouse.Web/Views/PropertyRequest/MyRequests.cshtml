
@using NextHouse.Application.UseCases.PropertyRequest.Queries.GetRequestByAgentId
@using NextHouse.Domain.Entities.Request

@model IReadOnlyList<GetPropertyRequestByAgentIdResponseDTO>

@{
    ViewData["Title"] = "Solicitudes";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>

    body {
        font-family: 'Poppins', sans-serif;
        background-color: #f5f7fa;
    }

    .requests-section {
        padding: 60px 0;
    }

    .page-header {
        margin-bottom: 40px;
    }

    .page-title {
        font-size: 42px;
        font-weight: 700;
        color: #0f172a
        margin-bottom: 10px;
    }

    .page-subtitle {
        color: #64748b;
        font-size: 16px;
    }

    .request-card {
        background: white;
        border-radius: 24px;
        padding: 28px;
        box-shadow: 0 10px 30px rgba(0,0,0,.06);
        transition: .3s ease;
        height: 100%;
    }

    .request-card:hover {
        transform: translateY(-5px);
    }

    .request-title {
        font-size: 22px;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 15px;
    }

    .request-info {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #64748b;
        margin-bottom: 12px;
        font-size: 15px;
    }

    .request-info i {
        color: #0d5c86;
        font-size: 18px;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 10px 18px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 600;
    }

    .status-pending {
        background-color: #fff7ed;
        color: #ea580c;
    }

    .status-approved {
        background-color: #ecfdf5;
        color: #059669;
    }

    .status-rejected {
        background-color: #fef2f2;
        color: #dc2626;
    }

    .card-footer-custom {
        margin-top: 25px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .details-btn {
        border: none;
        border-radius: 14px;
        background-color: #0d5c86;
        color: white;
        padding: 12px 20px;
        font-weight: 600;
        text-decoration: none;
        transition: .3s ease;
    }

    .details-btn:hover {
        background-color: #094564;
        color: white;
    }

    .empty-state {
        background: white;
        border-radius: 24px;
        padding: 80px 30px;
        text-align: center;
        box-shadow: 0 10px 30px rgba(0,0,0,.05);
    }

    .empty-state i {
        font-size: 90px;
        color: #cbd5e1;
        margin-bottom: 20px;
    }

    .empty-state h2 {
        font-size: 32px;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 10px;
    }

    .empty-state p {
        color: #64748b;
        max-width: 500px;
        margin: auto;
    }

</style>

<section class="requests-section">

    <div class="container">

        <div class="page-header">

            <h1 class="page-title">
                Solicitudes de propiedades
            </h1>

            <p class="page-subtitle">
                Administra las solicitudes recibidas para tus propiedades.
            </p>

        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="empty-state">

                <i class="bi bi-inbox"></i>

                <h2>
                    No tienes solicitudes
                </h2>

                <p>
                    Cuando los clientes envíen solicitudes sobre tus propiedades,
                    aparecerán aquí.
                </p>

            </div>
        }
        else
        {
            <div class="row g-4">

                @foreach (GetPropertyRequestByAgentIdResponseDTO request in Model)
                {
                    string statusClass = request.Status switch
                    {
                        RequestStatus.Pending => "status-pending",
                        RequestStatus.Approved => "status-approved",
                        RequestStatus.Rejected => "status-rejected",
                        _ => "status-pending"
                    };

                    <div class="col-lg-4 col-md-6">

                        <div class="request-card">

                            <h3 class="request-title">
                                @request.PropertyTitle
                            </h3>

                            <div class="request-info">

                                <i class="bi bi-calendar-event"></i>

                                <span>
                                    @request.CreatedAt.ToString("dd/MM/yyyy")
                                </span>

                            </div>

                            

                            <div class="card-footer-custom">

                                <span class="status-badge @statusClass">

                                    @request.Status

                                </span>

                                <a asp-controller="PropertyRequest"
                                       asp-action="Details"
                                       asp-route-id="@request.Id"
                                       class="details-btn">

                                    Ver solicitud

                                </a>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }

    </div>

</section>