@using NextHouse.Application.UseCases.Users.Queries.GetUsersList
@model List<GetUserResponseDTO>

@{
    ViewData["Title"] = "Usuarios";
}

<style>

    .page-wrapper {
        padding: 50px 0;
    }

    .page-header {
        margin-bottom: 35px;
    }

    .page-title {
        font-size: 38px;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 10px;
    }

    .page-subtitle {
        color: #64748b;
        font-size: 16px;
    }

    .users-card {
        background-color: white;
        border-radius: 28px;
        padding: 40px;
        box-shadow: 0 12px 35px rgba(0,0,0,.06);
    }

    .section-title {
        font-size: 22px;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 25px;
    }

    .create-btn {
        height: 56px;
        border: none;
        border-radius: 16px;
        background-color: #0d5c86;
        color: white;
        font-weight: 600;
        padding: 0 24px;
        transition: .3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
    }

        .create-btn:hover {
            background-color: #094564;
            color: white;
        }

    .table-modern {
        margin: 0;
        vertical-align: middle;
    }

        .table-modern thead th {
            border: none;
            background-color: #f8fafc;
            color: #475569;
            font-weight: 600;
            padding: 18px;
        }

        .table-modern tbody td {
            padding: 18px;
            border-color: #eef2f7;
        }

    .role-badge {
        background-color: #f0f7fc;
        color: #0d5c86;
        padding: 8px 14px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 600;
    }

    .action-btn {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        border: none;
        background-color: #f8fafc;
        color: #334155;
        transition: .3s ease;
    }

        .action-btn:hover {
            background-color: #0d5c86;
            color: white;
        }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
    }

        .empty-state i {
            font-size: 60px;
            color: #cbd5e1;
            margin-bottom: 15px;
        }

        .empty-state h5 {
            color: #334155;
            font-weight: 600;
        }

        .empty-state p {
            color: #64748b;
        }

</style>

<div class="container page-wrapper">

    <div class="page-header d-flex justify-content-between align-items-center">

        <div>
            <h1 class="page-title">
                Usuarios
            </h1>

            <p class="page-subtitle">
                Administra los usuarios registrados en la plataforma.
            </p>
        </div>

        <a asp-controller="Users"
               asp-action="Create"
               class="create-btn">

            <i class="bi bi-person-plus-fill me-2"></i>

            Nuevo usuario

        </a>

    </div>

    <div class="users-card">

        <h3 class="section-title">
            Listado de usuarios
        </h3>

        @if (Model.Any())
        {
            <div class="table-responsive">

                <table class="table table-modern">

                    <thead>

                        <tr>
                            <th>Nombre</th>
                            <th>Apellido</th>
                            <th>Correo</th>
                            <th>Rol</th>
                            <th width="120">Acciones</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var user in Model)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @user.FirstName
                                    </strong>
                                </td>
                                <td>
                                    <strong>
                                        @user.LastName
                                    </strong>
                                </td>
                                <td>
                                    @user.Email
                                </td>

                                <td>
                                    <span class="role-badge">
                                        @user.RoleName
                                    </span>
                                </td>

                                <td>

                                    <div class="d-flex gap-2">

                                        <a asp-controller="Users"
                                               asp-action="Edit"
                                               asp-route-id="@user.Id"
                                               class="action-btn d-flex align-items-center justify-content-center">

                                            <i class="bi bi-pencil-fill"></i>

                                        </a>

                                        <button type="button"
                                                class="action-btn">

                                            <i class="bi bi-trash-fill"></i>

                                        </button>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="empty-state">

                <i class="bi bi-people"></i>

                <h5>
                    No hay usuarios registrados
                </h5>

                <p>
                    Crea tu primer usuario para comenzar.
                </p>

            </div>
        }

    </div>

</div>