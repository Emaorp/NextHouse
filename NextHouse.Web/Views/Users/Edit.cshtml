@using NextHouse.Application.UseCases.Users.Queries.GetUserById
@model GetUserByIdResponseDTO

@{
    ViewData["Title"] = "Editar Usuario";
}

<style>

    .page-wrapper {
        padding: 50px 0;
    }

    .page-header {
        margin-bottom: 35px;
    }

    .page-title {
        font-size: 38px;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 10px;
    }

    .page-subtitle {
        color: #64748b;
        font-size: 16px;
    }

    .user-card {
        background-color: white;
        border-radius: 28px;
        padding: 40px;
        box-shadow: 0 12px 35px rgba(0,0,0,.06);
    }

    .section-title {
        font-size: 22px;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 25px;
    }

    .form-label {
        font-weight: 600;
        color: #334155;
        margin-bottom: 10px;
    }

    .form-control,
    .form-select {
        border-radius: 16px;
        border: 1px solid #dbe2ea;
        min-height: 56px;
        padding: 14px 18px;
        font-size: 15px;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #0d5c86;
            box-shadow: 0 0 0 .15rem rgba(13,92,134,.15);
        }

    .submit-btn {
        height: 58px;
        border: none;
        border-radius: 18px;
        background-color: #0d5c86;
        color: white;
        font-weight: 600;
        padding: 0 35px;
        transition: .3s ease;
    }

        .submit-btn:hover {
            background-color: #094564;
        }

    .cancel-btn {
        height: 58px;
        border-radius: 18px;
        font-weight: 600;
        padding: 0 35px;
    }

    @@media(max-width:768px) {

        .user-card {
            padding: 28px;
        }

        .page-title {
            font-size: 30px;
        }
    }

</style>

<div class="container page-wrapper">

    <div class="page-header">

        <h1 class="page-title">
            Editar usuario
        </h1>

        <p class="page-subtitle">
            Modifica la información del usuario y su rol.
        </p>

    </div>

    <div class="user-card">

        <form asp-controller="Users"
              asp-action="Edit"
              method="post">

            @Html.AntiForgeryToken()

            <input asp-for="Id" type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-4">
            </div>

            <h3 class="section-title">
                Información del usuario
            </h3>

            <div class="row">

                <div class="col-md-6 mb-4">

                    <label asp-for="FirstName"
                           class="form-label">
                        Nombre
                    </label>

                    <input asp-for="FirstName"
                           class="form-control" />

                    <span asp-validation-for="FirstName"
                          class="text-danger">
                    </span>

                </div>

                <div class="col-md-6 mb-4">

                    <label asp-for="LastName"
                           class="form-label">
                        Apellido
                    </label>

                    <input asp-for="LastName"
                           class="form-control" />

                    <span asp-validation-for="LastName"
                          class="text-danger">
                    </span>

                </div>

                <div class="col-md-6 mb-4">

                    <label asp-for="Email"
                           class="form-label">
                        Correo electrónico
                    </label>

                    <input asp-for="Email"
                           class="form-control" />

                    <span asp-validation-for="Email"
                          class="text-danger">
                    </span>

                </div>

                <div class="col-md-6 mb-4">

                    <label class="form-label">
                        Rol
                    </label>

                    <select asp-for="RoleId"
                            class="form-select"
                            asp-items="ViewBag.Roles">

                        <option value="">
                            Seleccione un rol
                        </option>

                    </select>

                </div>

            </div>

            <div class="d-flex gap-3 mt-4">

                <button type="submit"
                        class="submit-btn">

                    <i class="bi bi-check-circle-fill me-2"></i>

                    Guardar cambios

                </button>

                <a asp-controller="Users"
                       asp-action="Index"
                       class="btn btn-light cancel-btn">

                    Cancelar

                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}