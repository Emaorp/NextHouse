@using NextHouse.Application.Contracts.Security
@using NextHouse.Application.UseCases.Account.Queries.UserHasPermission
@using System.Security.Claims
@using NextHouse.Application.Utilites.Mediator
@inject IMediator Mediator
<!-- Views/Shared/_Layout.cshtml -->

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - NextHouse</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
          rel="stylesheet">

    <style>

            body {
                font-family: 'Poppins', sans-serif;
                background-color: #f5f7fa;
            }

            .navbar-custom {
                background-color: white;
                padding: 18px 0;
                box-shadow: 0 2px 12px rgba(0,0,0,.05);
            }

            .brand-logo {
                font-size: 32px;
                color: #0d5c86;
            }

            .brand-text {
                font-size: 28px;
                font-weight: 700;
                color: #0f172a;
            }

            .nav-link {
                color: #1e293b !important;
                font-weight: 500;
                margin-left: 15px;
                transition: .3s ease;
            }

                .nav-link:hover {
                    color: #0d5c86 !important;
                }

            .create-user-btn {
                background-color: #0d5c86;
                color: white !important;
                border-radius: 14px;
                padding: 12px 22px !important;
                font-weight: 600;
                border: none;
                transition: .3s ease;
            }

                .create-user-btn:hover {
                    background-color: #094564;
                    color: white !important;
                }

            .login-btn {
                color: #0d5c86 !important;
                font-weight: 600;
                margin-left: 15px;
                border: 2px solid #0d5c86;
                border-radius: 14px;
                padding: 10px 22px !important;
                transition: .3s ease;
            }

                .login-btn:hover {
                    background-color: #0d5c86;
                    color: white !important;
                }

            main {
                min-height: calc(100vh - 120px);
            }

            .footer {
                background-color: white;
                padding: 25px 0;
                margin-top: 60px;
                border-top: 1px solid #e2e8f0;
            }

            .footer-text {
                color: #64748b;
                margin: 0;
            }

    </style>

</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-light navbar-custom">

        <div class="container">

            <a class="navbar-brand d-flex align-items-center gap-2"
                   asp-controller="Home"
                   asp-action="Index">

                <i class="bi bi-house-door-fill brand-logo"></i>

                <span class="brand-text">
                    NextHouse
                </span>

            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarContent">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse"
                 id="navbarContent">

                <ul class="navbar-nav ms-auto align-items-lg-center">

                    <li class="nav-item">

                        <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">

                            Inicio

                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link"
                               asp-controller="Property"
                               asp-action="Index">

                            Propiedades

                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link"
                               href="#">

                            Nosotros

                        </a>

                    </li>

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
{
    <li class="nav-item dropdown ms-lg-3">

        <a class="nav-link dropdown-toggle d-flex align-items-center gap-2"
           href="#"
           role="button"
           data-bs-toggle="dropdown">

            <i class="bi bi-person-circle fs-5"></i>

            <span class="fw-semibold">
                @User.Identity.Name
            </span>

        </a>

        <ul class="dropdown-menu dropdown-menu-end shadow border-0">

            <li>

                <a class="dropdown-item"
                   asp-controller="Profile"
                   asp-action="Index">

                    <i class="bi bi-person me-2"></i>
                    Mi perfil

                </a>

            </li>

                                    @if (await Mediator.Send(new UserHasPermissionQuery
{
    UserId = User.FindFirstValue(ClaimTypes.NameIdentifier),
    PermissionCode = PermissionCodesCatalog.CREATE_USERS
}))
{
    <li>

        <a class="dropdown-item"
           asp-controller="Users"
           asp-action="Create">

            <i class="bi bi-person-plus me-2"></i>
            Crear usuario

        </a>

    </li>
}

                                @if (await Mediator.Send(new UserHasPermissionQuery
                    {
                        UserId = User.FindFirstValue(ClaimTypes.NameIdentifier),
                        PermissionCode = PermissionCodesCatalog.CREATE_PROPERTIES
                    })) { 
                                    <li>

                <a class="dropdown-item"
                   asp-controller="Property"
                   asp-action="Create">

                    <i class="bi bi-house-add me-2"></i>
                    Crear propiedad

                </a>

            </li>
                    }
                    
                                @if (await Mediator.Send(new UserHasPermissionQuery
                                {
                                    UserId = User.FindFirstValue(ClaimTypes.NameIdentifier),
                                    PermissionCode = PermissionCodesCatalog.SHOW_REQUESTS
                                }))
                                {
            <li>

                <a class="dropdown-item"
                   asp-controller="PropertyRequest"
                   asp-action="MyRequests">

                    <i class="bi bi-clipboard-check me-2"></i>
                    Mis solicitudes

                </a>

            </li>
                                }
            <li>
                <hr class="dropdown-divider">
            </li>

            <li>

                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="dropdown-item text-danger">

                        <i class="bi bi-box-arrow-right me-2"></i>
                        Cerrar sesión

                    </button>

                </form>

            </li>

        </ul>

    </li>
}
else
{
    <li class="nav-item ms-lg-3 mt-3 mt-lg-0 d-flex flex-column flex-lg-row gap-2">

        <a asp-controller="Account"
           asp-action="Login"
           class="btn login-btn">

            Iniciar sesión

        </a>

        <a asp-controller="Users"
           asp-action="Create"
           class="btn create-user-btn">

            Crear usuario

        </a>

    </li>
}

                </ul>

            </div>

        </div>

    </nav>

    <main>

        @RenderBody()

    </main>

    <footer class="footer">

        <div class="container text-center">

            <p class="footer-text">

                © @DateTime.Now.Year NextHouse.
                Todos los derechos reservados.

            </p>

        </div>

    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js">
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>