@using Microsoft.AspNetCore.Mvc.Rendering
@using NextHouse.Domain.Entities.Properties

@model NextHouse.Application.UseCases.Property.Commands.CreateProperty.CreatePropertyDto

@{
    ViewData["Title"] = "Crear Propiedad";
}

<style>
    .page-wrapper { padding: 50px 0; }
    .page-header { margin-bottom: 35px; }
    .page-title { font-size: 38px; font-weight: 700; color: #0f172a; margin-bottom: 10px; }
    .page-subtitle { color: #64748b; font-size: 16px; }
    .property-card { background-color: white; border-radius: 28px; padding: 40px; box-shadow: 0 12px 35px rgba(0,0,0,.06); }
    .section-title { font-size: 22px; font-weight: 700; color: #0f172a; margin-bottom: 25px; }
    .form-label { font-weight: 600; color: #334155; margin-bottom: 10px; }
    .form-control, .form-select, textarea {
        border-radius: 16px; border: 1px solid #dbe2ea;
        min-height: 56px; padding: 14px 18px; font-size: 15px; transition: .3s ease;
    }
    .form-control:focus, .form-select:focus, textarea:focus {
        border-color: #0d5c86; box-shadow: 0 0 0 .15rem rgba(13,92,134,.15);
    }
    textarea { min-height: 140px; resize: none; }
    .submit-btn {
        height: 58px; border: none; border-radius: 18px;
        background-color: #0d5c86; color: white; font-weight: 600;
        font-size: 16px; padding: 0 35px; transition: .3s ease;
    }
    .submit-btn:hover { background-color: #094564; }
    .cancel-btn { height: 58px; border-radius: 18px; font-weight: 600; padding: 0 35px; }
    .text-danger { font-size: 14px; margin-top: 6px; display: block; }

    /* Image upload */
    .image-upload-area {
        border: 2px dashed #dbe2ea; border-radius: 18px; padding: 30px;
        text-align: center; cursor: pointer; transition: .3s;
        background-color: #f8fafc;
    }
    .image-upload-area:hover { border-color: #0d5c86; background-color: #f0f7fc; }
    .image-upload-area i { font-size: 40px; color: #94a3b8; margin-bottom: 12px; }
    .image-preview-grid {
        display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
        gap: 12px; margin-top: 16px;
    }
    .image-preview-item {
        position: relative; border-radius: 12px; overflow: hidden;
        aspect-ratio: 1; background: #e2e8f0;
    }
    .image-preview-item img { width: 100%; height: 100%; object-fit: cover; }
    .image-preview-item .remove-btn {
        position: absolute; top: 6px; right: 6px;
        background: rgba(0,0,0,.6); color: white; border: none;
        border-radius: 50%; width: 26px; height: 26px;
        display: flex; align-items: center; justify-content: center;
        cursor: pointer; font-size: 13px;
    }
    .primary-badge {
        position: absolute; bottom: 6px; left: 6px;
        background: #0d5c86; color: white; font-size: 10px;
        font-weight: 600; padding: 2px 8px; border-radius: 20px;
    }
    .parking-toggle {
        display: flex; align-items: center; gap: 12px;
        padding: 16px 20px; border-radius: 16px; border: 1px solid #dbe2ea;
        cursor: pointer; transition: .3s; min-height: 56px;
    }
    .parking-toggle:hover { border-color: #0d5c86; }
    .parking-toggle.active { border-color: #0d5c86; background-color: #f0f7fc; }
    .parking-toggle i { font-size: 22px; color: #0d5c86; }

    @@media(max-width: 768px) {
        .property-card { padding: 28px; }
        .page-title { font-size: 30px; }
    }
</style>

<div class="container page-wrapper">

    <div class="page-header">
        <h1 class="page-title">Crear propiedad</h1>
        <p class="page-subtitle">Publica una nueva propiedad en la plataforma.</p>
    </div>

    <div class="property-card">

        <form asp-controller="Property"
              asp-action="Create"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

            <!-- INFORMACIÓN GENERAL -->
            <h3 class="section-title">Información general</h3>

            <div class="row">

                <div class="col-md-6 mb-4">
                    <label asp-for="Title" class="form-label">Título</label>
                    <input asp-for="Title" class="form-control"
                           placeholder="Ej: Apartamento moderno en Medellín" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-4">
                    <label asp-for="Type" class="form-label">Tipo de publicación</label>
                    <select asp-for="Type" class="form-select"
                            asp-items="Html.GetEnumSelectList<PropertyType>()">
                        <option value="">Selecciona una opción</option>
                    </select>
                    <span asp-validation-for="Type" class="text-danger"></span>
                </div>

                <div class="col-12 mb-4">
                    <label asp-for="Description" class="form-label">Descripción</label>
                    <textarea asp-for="Description" class="form-control"
                              placeholder="Describe detalladamente la propiedad..."></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

            </div>

            <!-- CARACTERÍSTICAS -->
            <h3 class="section-title mt-4">Características</h3>

            <div class="row">

                <div class="col-md-3 mb-4">
                    <label asp-for="Price" class="form-label">Precio</label>
                    <input asp-for="Price" class="form-control" placeholder="Ej: 350000000" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>

                <div class="col-md-3 mb-4">
                    <label asp-for="Bedrooms" class="form-label">Habitaciones</label>
                    <input asp-for="Bedrooms" type="number" min="0" class="form-control" />
                    <span asp-validation-for="Bedrooms" class="text-danger"></span>
                </div>

                <div class="col-md-3 mb-4">
                    <label asp-for="Bathrooms" class="form-label">Baños</label>
                    <input asp-for="Bathrooms" type="number" min="0" class="form-control" />
                    <span asp-validation-for="Bathrooms" class="text-danger"></span>
                </div>

                <div class="col-md-3 mb-4">
                    <label asp-for="Area" class="form-label">Área (m²)</label>
                    <input asp-for="Area" type="number" min="0" step="0.01" class="form-control" />
                    <span asp-validation-for="Area" class="text-danger"></span>
                </div>

                <div class="col-md-4 mb-4">
                    <label class="form-label">Parqueadero</label>
                    <div class="parking-toggle" id="parkingToggle">
                        <i class="bi bi-car-front-fill"></i>
                        <span id="parkingLabel">Sin parqueadero</span>
                        <input asp-for="HasParking" type="hidden" id="hasParkingInput" value="false" />
                    </div>
                </div>

            </div>

            <!-- FOTOS -->
            <h3 class="section-title mt-4">Fotos de la propiedad</h3>

            <div class="mb-4">
                <div class="image-upload-area" id="uploadArea">
                    <i class="bi bi-cloud-upload d-block"></i>
                    <p class="fw-semibold mb-1">Haz clic para subir fotos</p>
                    <p class="text-muted small">JPG, PNG o WebP — máximo 10 fotos</p>
                    <input type="file" id="imageInput" name="Images"
                           multiple accept="image/*"
                           style="display:none" />
                </div>
                <div class="image-preview-grid" id="previewGrid"></div>
                <p class="text-muted small mt-2" id="imageCount">0 / 10 fotos seleccionadas</p>
            </div>

            <!-- UBICACIÓN -->
            <h3 class="section-title mt-4">Ubicación</h3>

            <div class="row">

                <div class="col-md-6 mb-4">
                    <label class="form-label">Departamento</label>
                    <select class="form-select" id="department-select">
                        <option value="">Selecciona un departamento</option>
                        @foreach (SelectListItem department in ViewBag.Departments)
                        {
                            <option value="@department.Value">@department.Text</option>
                        }
                    </select>
                </div>

                <div class="col-md-6 mb-4">
                    <label asp-for="CityId" class="form-label">Ciudad</label>
                    <select asp-for="CityId" class="form-select" id="city-select">
                        <option value="">Selecciona una ciudad</option>
                    </select>
                    <span asp-validation-for="CityId" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-4">
                    <label asp-for="Neighborhood" class="form-label">Barrio</label>
                    <input asp-for="Neighborhood" class="form-control" placeholder="Ej: El Poblado" />
                    <span asp-validation-for="Neighborhood" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-4">
                    <label asp-for="Address" class="form-label">Dirección</label>
                    <input asp-for="Address" class="form-control" placeholder="Ej: Calle 10 #20-30" />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>

            </div>

            <div class="d-flex gap-3 mt-4">
                <button type="submit" class="submit-btn">
                    <i class="bi bi-house-add-fill me-2"></i>
                    Crear propiedad
                </button>
                <a asp-controller="Home" asp-action="Index" class="btn btn-light cancel-btn">
                    Cancelar
                </a>
            </div>

        </form>

    </div>

</div>

@section Scripts {

    <script>

        // ===========================
        // Parqueadero toggle
        // ===========================
        const parkingToggle = document.getElementById('parkingToggle');
        const parkingLabel = document.getElementById('parkingLabel');
        const hasParkingInput = document.getElementById('hasParkingInput');
        let hasParking = false;

        parkingToggle.addEventListener('click', function () {
            hasParking = !hasParking;
            hasParkingInput.value = hasParking;
            parkingLabel.textContent = hasParking ? 'Con parqueadero' : 'Sin parqueadero';
            this.classList.toggle('active', hasParking);
        });

        // ===========================
        // Subida de imágenes
        // ===========================
        const uploadArea = document.getElementById('uploadArea');
        const imageInput = document.getElementById('imageInput');
        const previewGrid = document.getElementById('previewGrid');
        const imageCount = document.getElementById('imageCount');
        let selectedFiles = [];

        uploadArea.addEventListener('click', () => imageInput.click());

        uploadArea.addEventListener('dragover', e => {
            e.preventDefault();
            uploadArea.style.borderColor = '#0d5c86';
        });

        uploadArea.addEventListener('dragleave', () => {
            uploadArea.style.borderColor = '#dbe2ea';
        });

        uploadArea.addEventListener('drop', e => {
            e.preventDefault();
            uploadArea.style.borderColor = '#dbe2ea';
            handleFiles(Array.from(e.dataTransfer.files));
        });

        imageInput.addEventListener('change', function () {
            handleFiles(Array.from(this.files));
        });

        function handleFiles(files) {
            const imageFiles = files.filter(f => f.type.startsWith('image/'));
            const available = 10 - selectedFiles.length;
            const toAdd = imageFiles.slice(0, available);
            selectedFiles = [...selectedFiles, ...toAdd];
            renderPreviews();
            syncFileInput();
        }

        function renderPreviews() {
            previewGrid.innerHTML = '';
            imageCount.textContent = `${selectedFiles.length} / 10 fotos seleccionadas`;

            selectedFiles.forEach((file, index) => {
                const reader = new FileReader();
                reader.onload = e => {
                    const item = document.createElement('div');
                    item.className = 'image-preview-item';
                    item.innerHTML = `
                        <img src="${e.target.result}" alt="Foto ${index + 1}" />
                        ${index === 0 ? '<span class="primary-badge">Principal</span>' : ''}
                        <button type="button" class="remove-btn" data-index="${index}">
                            <i class="bi bi-x"></i>
                        </button>
                    `;
                    item.querySelector('.remove-btn').addEventListener('click', function () {
                        selectedFiles.splice(parseInt(this.dataset.index), 1);
                        renderPreviews();
                        syncFileInput();
                    });
                    previewGrid.appendChild(item);
                };
                reader.readAsDataURL(file);
            });
        }

        function syncFileInput() {
            const dt = new DataTransfer();
            selectedFiles.forEach(f => dt.items.add(f));
            imageInput.files = dt.files;
        }

        // ===========================
        // Ciudades por departamento
        // ===========================
        const departmentSelect = document.getElementById('department-select');
        const citySelect = document.getElementById('city-select');

        departmentSelect.addEventListener('change', async function () {
            const departmentId = this.value;
            citySelect.innerHTML = '<option value="">Cargando ciudades...</option>';

            if (!departmentId) {
                citySelect.innerHTML = '<option value="">Selecciona una ciudad</option>';
                return;
            }

            const response = await fetch(`/Property/GetCities?departmentId=${departmentId}`);
            const cities = await response.json();
            citySelect.innerHTML = '<option value="">Selecciona una ciudad</option>';
            cities.forEach(city => {
                citySelect.innerHTML += `<option value="${city.id}">${city.name}</option>`;
            });
        });

    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
